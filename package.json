{
  "name": "paintblast-mr",
  "version": "1.0.0",
  "description": "Mixed Reality paint ball throwing game built on IWSDK with hand tracking, physics, and agentic dev tools",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "qr": "node scripts/launch-qr.mjs",
    "qr:dev": "node scripts/launch-qr.mjs --dev",
    "deploy": "npm run build && netlify deploy --prod --dir dist",
    "launch": "npm run deploy && npm run qr"
  },
  "dependencies": {
    "@iwsdk/core": "0.3.1",
    "three": "npm:super-three@0.181.0"
  },
  "devDependencies": {
    "@felixtz/iwsdk-rag-mcp": "^0.3.1",
    "@iwsdk/vite-plugin-dev": "0.3.1",
    "@iwsdk/vite-plugin-uikitml": "0.3.1",
    "@meta-quest/hzdb": "^1.0.0",
    "@types/three": "*",
    "@vitest/ui": "^2.1.0",
    "happy-dom": "^15.0.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "typescript": "^5.5.0",
    "vite": "^7.1.4",
    "vite-plugin-mkcert": "^1.17.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
