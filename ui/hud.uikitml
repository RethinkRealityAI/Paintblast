<style>
  /* Splotopia HUD - round 9 (round 8 "techno-paint" theme, onboarding pass).

     UIKitML units are CENTIMETRES. The whole panel is one document; HudSystem
     shows exactly one section at a time (the LOADOUT screen is a sub-screen of
     the title, the tutorial card replaces whatever the phase would show) and
     leaves the footer up.

     Round 9 legibility rule: no player-facing text below 1.8 units. Copy was
     trimmed to fit rather than shrunk; the title lost its how-to tiles (Pip's
     tutorial teaches by doing now).

     Design tokens (keep in sync with HudSystem's ACCENT_* constants):
       graphite glass  rgba(11, 12, 20, 0.88)   off-white #f4f1ea
       coral  #ff4f81  amber #ffd23f  cyan #48dbfb  lime #b6ff3b  violet #b84dff
       muted text #9a9cb0   hairline rgba(255, 255, 255, 0.10)

     uikit rules this file lives by (CLAUDE.md gotchas 24-27):
       - ASCII only in text: the bundled MSDF font has no dashes, ellipsis, x.
       - no background-opacity and no gradients: alpha rides in rgba() strings,
         "neon" is a crisp 1-2 mm border over a wide, faint halo border.
       - show/hide is `display`, written by HudSystem.
       - icons and paint drips are inline <svg> with FILLED paths only (uikit
         meshes SVG fills; strokes are ignored).
     Edit this file only: public/ui/hud.json is generated from it. */

  /* --- Frame: a faint violet halo around a crisp cyan neon line ---------- */
  .hud-halo {
    display: flex;
    flex-direction: column;
    padding: 0.45;
    border-radius: 4;
    border-width: 0.45;
    border-color: rgba(184, 77, 255, 0.4);
  }
  .hud-root {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 68;
    padding-x: 3.2;
    padding-top: 2.4;
    padding-bottom: 2;
    gap: 1.2;
    background-color: rgba(4, 5, 10, 0.93);
    border-radius: 3.4;
    border-width: 0.16;
    border-color: #48dbfb;
  }
  /* Paint drips hanging off the frame. Absolutely positioned, so they never
     take part in layout and every section can grow without moving them. */
  .drip-left {
    position: absolute;
    top: -0.5;
    left: 12;
    width: 7;
    height: 4.2;
  }
  .drip-right {
    position: absolute;
    top: -0.5;
    right: 11;
    width: 5.2;
    height: 4.9;
  }

  .section {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    gap: 1.2;
  }
  /* Every non-title section starts hidden so the panel never flashes all of
     them at once on the frame before HudSystem binds. */
  .section-hidden {
    display: none;
    flex-direction: column;
    align-items: center;
    width: 100%;
    gap: 1.2;
  }

  /* --- Shared type -------------------------------------------------------- */
  .kicker {
    font-size: 1.9;
    font-weight: bold;
    letter-spacing: 0.32;
    color: #48dbfb;
  }
  .kicker-coral {
    font-size: 1.9;
    font-weight: bold;
    letter-spacing: 0.32;
    color: #ff4f81;
  }
  .kicker-lime {
    font-size: 1.9;
    font-weight: bold;
    letter-spacing: 0.32;
    color: #b6ff3b;
  }
  .label {
    font-size: 1.8;
    font-weight: bold;
    letter-spacing: 0.24;
    color: #9a9cb0;
  }
  .tagline {
    font-size: 2.3;
    font-weight: medium;
    color: #f4f1ea;
    text-align: center;
  }
  .hint-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 0.7;
  }
  .hint {
    font-size: 1.8;
    color: #9a9cb0;
    text-align: center;
  }
  .icon-s {
    width: 2.2;
    height: 2.2;
  }
  .icon-m {
    width: 2.8;
    height: 2.8;
  }
  .icon-l {
    width: 3.8;
    height: 3.8;
  }
  /* Icon + label buttons: the text child grows to fill (UIKitML gives text
     flex-grow 1), so a spacer the icon's width on the far side keeps the
     label optically centred in the pill. */
  .btn-text {
    font-size: 3.2;
    font-weight: bold;
    letter-spacing: 0.3;
    color: #0b0c14;
    text-align: center;
  }
  .btn-text-s {
    font-size: 2.4;
    font-weight: bold;
    letter-spacing: 0.24;
    color: #0b0c14;
    text-align: center;
  }
  .spacer-m {
    width: 2.8;
    height: 0.1;
  }
  .spacer-s {
    width: 2.2;
    height: 0.1;
  }

  /* The paint stripe: five neon bars, one per accent. Solid segments stand
     in for the gradient uikit cannot draw. */
  .stripe {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.35;
  }
  .bar-coral { width: 5.2; height: 0.5; border-radius: 0.25; background-color: #ff4f81; }
  .bar-amber { width: 5.2; height: 0.5; border-radius: 0.25; background-color: #ffd23f; }
  .bar-cyan { width: 5.2; height: 0.5; border-radius: 0.25; background-color: #48dbfb; }
  .bar-lime { width: 5.2; height: 0.5; border-radius: 0.25; background-color: #b6ff3b; }
  .bar-violet { width: 5.2; height: 0.5; border-radius: 0.25; background-color: #b84dff; }
  .bar-short-coral { width: 2.4; height: 0.4; border-radius: 0.2; background-color: #ff4f81; }
  .bar-short-amber { width: 2.4; height: 0.4; border-radius: 0.2; background-color: #ffd23f; }
  .bar-short-cyan { width: 2.4; height: 0.4; border-radius: 0.2; background-color: #48dbfb; }
  .bar-short-lime { width: 2.4; height: 0.4; border-radius: 0.2; background-color: #b6ff3b; }
  .bar-short-violet { width: 2.4; height: 0.4; border-radius: 0.2; background-color: #b84dff; }

  /* --- Title -------------------------------------------------------------- */
  .logo {
    width: 50;
    margin-top: -0.4;
    margin-bottom: -0.4;
  }
  .btn-row-fill {
    display: flex;
    flex-direction: row;
    align-items: center;
    width: 100%;
    gap: 1.2;
  }
  .btn-half {
    flex-grow: 1;
    flex-basis: 0;
  }

  /* --- Buttons ------------------------------------------------------------ */
  /* HudSystem repaints background, border and scale on hover / press (see
     wireInteractiveButton); what is declared here is the resting look. Keep
     colours as rgba() - uikit reads a background's opacity out of the colour
     itself, so each state is the same string with a different last number. */
  .btn-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 1.2;
  }
  .btn-play {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 1;
    width: 100%;
    padding-x: 2.4;
    padding-y: 1.6;
    font-size: 3.2;
    font-weight: bold;
    letter-spacing: 0.3;
    color: #0b0c14;
    background-color: #ffd23f;
    border-radius: 3;
    border-width: 0.3;
    border-color: #fff3b8;
  }
  .btn-play-small {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 0.8;
    width: 18;
    padding-x: 1.8;
    padding-y: 1;
    font-size: 2.4;
    font-weight: bold;
    letter-spacing: 0.24;
    color: #0b0c14;
    background-color: #ffd23f;
    border-radius: 2.2;
    border-width: 0.16;
    border-color: #fff3b8;
  }
  .btn-lime {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 0.9;
    width: 36;
    padding-x: 2.4;
    padding-y: 1.3;
    font-size: 2.8;
    font-weight: bold;
    letter-spacing: 0.26;
    color: #0b0c14;
    background-color: #b6ff3b;
    border-radius: 2.8;
    border-width: 0.18;
    border-color: #e9ffc2;
  }
  /* Outline pills: a whisper of the accent as fill so the hit target is still
     findable against passthrough, and a crisp accent line. */
  .btn-line {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 0.7;
    width: 18;
    padding-y: 1;
    font-size: 2.1;
    font-weight: bold;
    letter-spacing: 0.16;
    color: #f4f1ea;
    border-radius: 2.2;
    border-width: 0.14;
  }
  .line-cyan { background-color: rgba(72, 219, 251, 0.08); border-color: #48dbfb; }
  .line-coral { background-color: rgba(255, 79, 129, 0.08); border-color: #ff4f81; }
  .line-violet { background-color: rgba(184, 77, 255, 0.08); border-color: #b84dff; }
  .line-amber { background-color: rgba(255, 210, 63, 0.08); border-color: #ffd23f; }
  .line-lime { background-color: rgba(182, 255, 59, 0.08); border-color: #b6ff3b; }
  .line-glass { background-color: rgba(255, 255, 255, 0.06); border-color: rgba(255, 255, 255, 0.28); }
  .btn-chill {
    width: 26;
  }
  .btn-glass {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 0.5;
    padding-x: 1.6;
    padding-y: 0.7;
    font-size: 1.8;
    font-weight: bold;
    letter-spacing: 0.14;
    color: #c9cad6;
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 0.1;
    border-color: rgba(255, 255, 255, 0.22);
    border-radius: 1.6;
  }

  /* --- Loadout readout (title) ------------------------------------------- */
  .loadout {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1;
    padding-left: 1.6;
    padding-right: 0.6;
    padding-y: 0.6;
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: 1.8;
    border-width: 0.08;
    border-color: rgba(255, 255, 255, 0.12);
  }
  .loadout-value {
    font-size: 1.9;
    font-weight: bold;
    letter-spacing: 0.14;
    color: #f4f1ea;
  }
  .loadout-dot {
    width: 1.8;
    height: 1.8;
    border-radius: 0.9;
    background-color: #ff4f81;
    border-width: 0.16;
    border-color: #ffb347;
  }
  .btn-armory {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: 0.8;
    width: 17;
    padding-y: 0.8;
    font-size: 1.9;
    font-weight: bold;
    letter-spacing: 0.2;
    color: #f4f1ea;
    background-color: rgba(184, 77, 255, 0.08);
    border-width: 0.14;
    border-color: #b84dff;
    border-radius: 1.8;
  }
  .sep {
    width: 0.1;
    height: 1.8;
    background-color: rgba(255, 255, 255, 0.18);
  }

  /* Room-scan notice: an amber advisory strip, hidden until SceneScanSystem
     says the headset has no scene model to give us. */
  .scan-notice {
    display: none;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 1;
    padding-y: 0.8;
    padding-x: 1.4;
    background-color: rgba(255, 210, 63, 0.08);
    border-width: 0.1;
    border-color: rgba(255, 210, 63, 0.5);
    border-radius: 1.6;
  }
  .scan-text {
    flex-shrink: 1;
    font-size: 1.8;
    color: #ffd23f;
  }
  .btn-scan {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    padding-x: 1.6;
    padding-y: 0.7;
    font-size: 1.8;
    font-weight: bold;
    letter-spacing: 0.14;
    color: #ffd23f;
    background-color: rgba(255, 210, 63, 0.08);
    border-width: 0.12;
    border-color: #ffd23f;
    border-radius: 1.6;
  }

  /* --- LOADOUT screen (ids keep their round-8 "armory" names) ------------ */
  .armory-title {
    font-size: 4.6;
    font-weight: bold;
    letter-spacing: 0.4;
    color: #f4f1ea;
  }
  .mode-row {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    justify-content: center;
    gap: 1.2;
    width: 100%;
  }
  .mode-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-grow: 1;
    flex-basis: 0;
    gap: 0.5;
    padding-y: 1.2;
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: 2;
    border-width: 0.14;
    border-color: rgba(255, 255, 255, 0.18);
  }
  .mode-name {
    font-size: 2.2;
    font-weight: bold;
    letter-spacing: 0.2;
    color: #f4f1ea;
  }
  .mode-sub {
    font-size: 1.8;
    color: #9a9cb0;
  }
  .desc {
    font-size: 1.9;
    color: #c9cad6;
    text-align: center;
  }
  .skin-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 1.6;
    width: 100%;
  }
  .btn-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 5;
    height: 5;
    font-size: 2.6;
    font-weight: bold;
    color: #f4f1ea;
    background-color: rgba(184, 77, 255, 0.1);
    border-width: 0.14;
    border-color: #b84dff;
    border-radius: 2.5;
  }
  .skin-card {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1.4;
    width: 34;
    padding-x: 1.6;
    padding-y: 1;
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: 2;
    border-width: 0.14;
    border-color: #ff4f81;
  }
  .skin-swatch {
    width: 4.4;
    height: 4.4;
    border-radius: 2.2;
    background-color: #ff4f81;
    border-width: 0.45;
    border-color: #ffb347;
  }
  .skin-text {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: 0.3;
  }
  .skin-name {
    font-size: 2.3;
    font-weight: bold;
    letter-spacing: 0.18;
    color: #f4f1ea;
  }
  .dot-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 1.3;
  }
  /* One button per skin; HudSystem paints fill and ring from BLASTER.skins
     and hides any dot past the end of the list. 3.4 cm: a comfortable ray
     target at a metre. */
  .skin-dot {
    width: 3.4;
    height: 3.4;
    border-radius: 1.7;
    background-color: #ff4f81;
    border-width: 0.3;
    border-color: rgba(255, 255, 255, 0.25);
  }

  /* --- Live round --------------------------------------------------------- */
  .score-row {
    display: flex;
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    width: 100%;
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.3;
  }
  .stat-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.3;
  }
  .score {
    font-size: 7.6;
    font-weight: bold;
    color: #f4f1ea;
  }
  .timer {
    font-size: 6;
    font-weight: bold;
    color: #48dbfb;
  }
  .underline-amber { width: 14; height: 0.5; border-radius: 0.25; background-color: #ffd23f; }
  .underline-cyan { width: 10; height: 0.5; border-radius: 0.25; background-color: #48dbfb; }
  .row-center {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 1.2;
  }
  /* HudSystem repaints backgroundColor per combo level; resting look only. */
  .combo {
    display: none;
    padding-x: 1.4;
    padding-y: 0.45;
    font-size: 2.2;
    font-weight: bold;
    letter-spacing: 0.12;
    color: #0b0c14;
    background-color: #ffd23f;
    border-radius: 1.4;
  }
  .bots {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.6;
    padding-x: 1.2;
    padding-y: 0.45;
    background-color: rgba(255, 79, 129, 0.08);
    border-width: 0.1;
    border-color: rgba(255, 79, 129, 0.6);
    border-radius: 1.4;
  }
  .bots-text {
    font-size: 2.1;
    font-weight: bold;
    color: #f4f1ea;
  }
  .status {
    font-size: 2;
    color: #c9cad6;
    text-align: center;
  }
  /* First-encounter coaching tip: replaces the status line for ~3 s. */
  .coach {
    display: none;
    padding-x: 1.4;
    padding-y: 0.5;
    font-size: 2.1;
    font-weight: bold;
    color: #ffd23f;
    background-color: rgba(255, 210, 63, 0.1);
    border-width: 0.14;
    border-color: #ffd23f;
    border-radius: 1.4;
  }

  /* --- Results card (round over) ----------------------------------------- */
  .final {
    font-size: 8.4;
    font-weight: bold;
    color: #f4f1ea;
    text-align: center;
  }
  .newbest {
    display: none;
    padding-x: 1.4;
    padding-y: 0.4;
    font-size: 1.9;
    font-weight: bold;
    letter-spacing: 0.3;
    color: #0b0c14;
    background-color: #b6ff3b;
    border-radius: 1.2;
  }
  .best {
    font-size: 1.9;
    font-weight: bold;
    letter-spacing: 0.18;
    color: #9a9cb0;
    text-align: center;
  }
  .cell-row {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    width: 100%;
    gap: 1;
  }
  .cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-grow: 1;
    flex-basis: 0;
    gap: 0.2;
    padding-y: 0.7;
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: 1.6;
    border-width: 0.1;
    border-color: rgba(255, 255, 255, 0.14);
  }
  .cell-coral { border-color: rgba(255, 79, 129, 0.6); }
  .cell-cyan { border-color: rgba(72, 219, 251, 0.6); }
  .cell-violet { border-color: rgba(184, 77, 255, 0.6); }
  .cell-amber { border-color: rgba(255, 210, 63, 0.6); }
  .cell-value {
    font-size: 3.2;
    font-weight: bold;
    color: #f4f1ea;
  }
  .cell-name {
    font-size: 1.8;
    font-weight: bold;
    letter-spacing: 0.16;
    color: #9a9cb0;
  }
  .goal {
    font-size: 2.1;
    font-weight: bold;
    color: #b6ff3b;
    text-align: center;
  }

  /* --- Tutorial card (docked low while Pip teaches) ----------------------- */
  .tut-head {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }
  .tut-count {
    font-size: 1.9;
    font-weight: bold;
    letter-spacing: 0.2;
    color: #9a9cb0;
  }
  .tut-line {
    font-size: 3.4;
    font-weight: bold;
    color: #f4f1ea;
    text-align: center;
  }
  .tut-dot {
    width: 5;
    height: 0.8;
    border-radius: 0.4;
    background-color: rgba(255, 255, 255, 0.18);
  }
  .tut-foot {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }
  .btn-skip {
    width: 14;
  }

  /* --- Chill -------------------------------------------------------------- */
  .chill-title {
    font-size: 4.4;
    font-weight: bold;
    letter-spacing: 0.3;
    color: #48dbfb;
  }

  /* PAUSED pill: the first child of the panel, above whichever section is
     showing. Hidden until the session loses focus mid-round. Amber on the dark
     glass so it still reads through Quest's own dimming. */
  .paused {
    display: none;
    padding-x: 2;
    padding-y: 0.5;
    font-size: 2.2;
    font-weight: bold;
    letter-spacing: 0.4;
    color: #0b0c14;
    background-color: #ffd23f;
    border-radius: 1.6;
  }

  /* --- Persistent footer -------------------------------------------------- */
  .footer {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-top: 0.3;
    padding-top: 1;
    border-top-width: 0.08;
    border-color: rgba(255, 255, 255, 0.12);
  }
  .footer-right {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.8;
  }
  .mode-chip {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding-x: 1.2;
    padding-y: 0.5;
    font-size: 1.8;
    font-weight: bold;
    letter-spacing: 0.2;
    color: #ff4f81;
    background-color: rgba(255, 79, 129, 0.1);
    border-width: 0.1;
    border-color: #ff4f81;
    border-radius: 1.4;
  }
  .ammo-chip {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.6;
    padding-x: 1.1;
    padding-y: 0.5;
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 0.1;
    border-color: rgba(255, 255, 255, 0.2);
    border-radius: 1.4;
  }
  .swatch {
    width: 1.8;
    height: 1.8;
    border-radius: 0.9;
    background-color: #ff6b6b;
    border-width: 0.12;
    border-color: rgba(255, 255, 255, 0.6);
  }
  .ammo {
    font-size: 1.8;
    font-weight: bold;
    letter-spacing: 0.2;
    color: #f4f1ea;
  }
</style>
<div class="hud-halo">
<div class="hud-root">
  <svg class="drip-left" viewBox="0 0 90 54"><path fill="#ff4f81" d="M0 0 H90 V6 C80 6 78 9 77 16 C76 24 70 25 69 16 C68 9 62 7 56 8 C51 9 50 14 50 30 C50 42 41 42 41 30 C41 16 38 9 30 8 C24 7 22 12 21 22 C20 30 13 30 13 21 C13 12 8 7 0 7 Z"/><path fill="#ff4f81" d="M45.5 46 C48.5 46 50 48.5 50 50.5 C50 53 48 54 45.5 54 C43 54 41 53 41 50.5 C41 48.5 42.5 46 45.5 46 Z"/></svg>
  <svg class="drip-right" viewBox="0 0 70 66"><path fill="#b6ff3b" d="M0 0 H70 V7 C64 7 61 10 60 20 C59 34 52 34 51 20 C50 11 46 8 40 9 C34 10 33 16 33 40 C33 56 23 56 23 40 C23 18 21 9 12 8 C6 7 3 9 0 10 Z"/><path fill="#b6ff3b" d="M28 58 C31 58 32.5 60.5 32.5 62.5 C32.5 65 30.5 66 28 66 C25.5 66 23.5 65 23.5 62.5 C23.5 60.5 25 58 28 58 Z"/></svg>
  <span id="hud-paused" class="paused">PAUSED</span>

  <!-- ===== Title ======================================================= -->
  <div id="section-idle" class="section">
    <span class="kicker">YOUR ROOM IS THE ARENA</span>
    <img class="logo" src="./brand/logo.png" />
    <span class="tagline">The Neatniks are tidying your room. Paint them out!</span>
    <button id="btn-start" class="btn-play"><svg class="icon-m" viewBox="0 0 24 24"><path fill="#0b0c14" d="M6 3.5 L21 12 L6 20.5 Z"/></svg><span class="btn-text">PLAY</span><div class="spacer-m"></div></button>
    <div class="btn-row-fill">
      <button id="btn-chill" class="btn-line line-cyan btn-half">CHILL MODE</button>
      <button id="btn-tutorial" class="btn-line line-lime btn-half">TUTORIAL</button>
    </div>
    <div class="loadout">
      <span id="hud-loadout-mode" class="loadout-value">BLASTER</span>
      <div class="sep"></div>
      <div id="hud-loadout-swatch" class="loadout-dot"></div>
      <span id="hud-loadout-skin" class="loadout-value">NEON CORAL</span>
      <button id="btn-armory" class="btn-armory">LOADOUT &gt;</button>
    </div>
    <div class="hint-row">
      <svg class="icon-s" viewBox="0 0 24 24"><path fill="#48dbfb" d="M9 2 A1.6 1.6 0 0 1 12.2 2 V11 H13 V8.6 A1.6 1.6 0 0 1 16.2 8.6 V11.4 H16.8 V9.8 A1.6 1.6 0 0 1 20 9.8 V16 C20 20.5 17 23.5 13 23.5 C9.5 23.5 7.6 21.8 6 19 L3 13.6 A1.6 1.6 0 0 1 5.8 12 L9 16 Z"/></svg>
      <span class="hint">Buttons: point your RIGHT hand, then pinch</span>
    </div>
    <div id="scan-notice" class="scan-notice">
      <span id="scan-notice-text" class="scan-text">No room scan - paint has no walls to stick to</span>
      <button id="btn-scan-room" class="btn-scan">SCAN ROOM</button>
    </div>
  </div>

  <!-- ===== Live round ================================================== -->
  <div id="section-playing" class="section-hidden">
    <div class="score-row">
      <div class="stat">
        <span class="label">SCORE</span>
        <span id="hud-score" class="score">0</span>
        <div class="underline-amber"></div>
      </div>
      <div class="stat-right">
        <span class="label">TIME</span>
        <span id="hud-timer" class="timer">1:30</span>
        <div id="hud-timer-bar" class="underline-cyan"></div>
      </div>
    </div>
    <div class="row-center">
      <span id="hud-combo" class="combo">x1</span>
      <div class="bots">
        <svg class="icon-s" viewBox="0 0 24 24"><path fill="#ff4f81" d="M11 0.5 H13 V4 H11 Z"/><path fill="#ff4f81" d="M4 4 H20 A3 3 0 0 1 23 7 V17 A3 3 0 0 1 20 20 H4 A3 3 0 0 1 1 17 V7 A3 3 0 0 1 4 4 Z"/><path fill="#0b0c14" d="M6 9 H10 V13 H6 Z M14 9 H18 V13 H14 Z M8 15.5 H16 V17 H8 Z"/></svg>
        <span id="hud-targets" class="bots-text">0 Neatniks</span>
      </div>
      <span id="hud-status" class="status">Get ready</span>
      <span id="hud-coach" class="coach">Tip</span>
    </div>
  </div>

  <!-- ===== Results card (round over) =================================== -->
  <div id="section-gameover" class="section-hidden">
    <span class="kicker-coral">ROUND OVER</span>
    <span id="hud-final" class="final">0</span>
    <div class="row-center">
      <span id="hud-newbest" class="newbest">NEW BEST</span>
      <span id="hud-best" class="best">BEST 0</span>
    </div>
    <div class="cell-row">
      <div class="cell cell-coral"><span id="res-pops-0" class="cell-value">0</span><span class="cell-name">MOPSY</span></div>
      <div class="cell cell-cyan"><span id="res-pops-1" class="cell-value">0</span><span class="cell-name">SQUEEGEE</span></div>
      <div class="cell cell-violet"><span id="res-pops-2" class="cell-value">0</span><span class="cell-name">PEEKABOO</span></div>
      <div class="cell cell-amber"><span id="res-pops-3" class="cell-value">0</span><span class="cell-name">DUKE</span></div>
    </div>
    <div class="cell-row">
      <div class="cell"><span id="res-shots" class="cell-value">0</span><span class="cell-name">SHOTS</span></div>
      <div class="cell"><span id="res-hits" class="cell-value">0</span><span class="cell-name">HITS</span></div>
      <div class="cell"><span id="res-acc" class="cell-value">0%</span><span class="cell-name">ACCURACY</span></div>
      <div class="cell"><span id="res-combo" class="cell-value">x1</span><span class="cell-name">BEST COMBO</span></div>
    </div>
    <span id="res-goal" class="goal">Next: pinch at a Neatnik to pop it</span>
    <button id="btn-restart" class="btn-lime"><svg class="icon-m" viewBox="0 0 24 24"><path fill="#0b0c14" d="M6 3.5 L21 12 L6 20.5 Z"/></svg><span class="btn-text">PLAY AGAIN</span><div class="spacer-m"></div></button>
  </div>

  <!-- ===== Chill ======================================================= -->
  <div id="section-chill" class="section-hidden">
    <span class="kicker">NO TIMER - NO NEATNIKS - JUST PAINT</span>
    <span class="chill-title">CHILL MODE</span>
    <div class="stripe">
      <div class="bar-short-coral"></div>
      <div class="bar-short-amber"></div>
      <div class="bar-short-cyan"></div>
      <div class="bar-short-lime"></div>
      <div class="bar-short-violet"></div>
    </div>
    <span id="hud-chill-status" class="status">Hold trigger or pinch to spray. Tap the palette to change paint.</span>
    <span class="hint">Paint the easel, then save the picture</span>
    <span class="hint">Pinch or squeeze the easel with both hands to move it</span>
    <div class="btn-row">
      <button id="btn-save-painting" class="btn-line line-amber btn-chill">SAVE PAINTING</button>
      <button id="btn-new-canvas" class="btn-line line-cyan btn-chill">NEW CANVAS</button>
    </div>
    <div class="btn-row">
      <button id="btn-orientation" class="btn-line line-lime btn-chill">ROTATE CANVAS</button>
      <button id="btn-exit-chill" class="btn-line line-coral btn-chill">EXIT CHILL</button>
    </div>
  </div>

  <!-- ===== LOADOUT (title sub-screen; ids keep the round-8 armory names) == -->
  <div id="section-armory" class="section-hidden">
    <span class="armory-title">LOADOUT</span>
    <div class="stripe">
      <div class="bar-short-violet"></div>
      <div class="bar-short-coral"></div>
      <div class="bar-short-amber"></div>
      <div class="bar-short-cyan"></div>
      <div class="bar-short-lime"></div>
    </div>
    <div class="mode-row">
      <button id="btn-mode-hand" class="mode-card">
        <svg class="icon-l" viewBox="0 0 24 24"><path fill="#f4f1ea" d="M9 2 A1.6 1.6 0 0 1 12.2 2 V11 H13 V3.4 A1.6 1.6 0 0 1 16.2 3.4 V11.4 H16.8 V6 A1.6 1.6 0 0 1 20 6 V16 C20 20.5 17 23.5 13 23.5 C9.5 23.5 7.6 21.8 6 19 L2.6 12.6 A1.6 1.6 0 0 1 5.4 11 L9 15 Z"/></svg>
        <span class="mode-name">HAND</span>
        <span class="mode-sub">Bare hands</span>
      </button>
      <button id="btn-mode-blaster" class="mode-card">
        <svg class="icon-l" viewBox="0 0 24 24"><path fill="#ff4f81" d="M2 7 H17 L22 9.5 V12.5 L17 15 H2 A1 1 0 0 1 1 14 V8 A1 1 0 0 1 2 7 Z"/><path fill="#f4f1ea" d="M5 15 H10 L8.5 22 H4 Z"/><path fill="#ffd23f" d="M8 9 H14 V13 H8 Z"/></svg>
        <span class="mode-name">BLASTER</span>
        <span class="mode-sub">Auto-fire</span>
      </button>
      <button id="btn-mode-web" class="mode-card">
        <svg class="icon-l" viewBox="0 0 24 24"><path fill="#48dbfb" d="M7 2 C10 2 11 4.5 11 7 C11 9 10 10 10 12 C10 14 11.5 15 11.5 17 A2.5 2.5 0 0 1 6.5 17 C6.5 15 8 14 8 12 C8 10 3 9.5 3 6 C3 3.5 4.8 2 7 2 Z"/><path fill="#48dbfb" d="M17 4 C19.5 4 21 6 21 8.5 C21 11 19 12 19 14 C19 15.5 20 16.5 20 18 A2 2 0 0 1 16 18 C16 16.5 17 15.5 17 14 C17 12 13.5 11.5 13.5 8 C13.5 5.8 15 4 17 4 Z"/><path fill="#48dbfb" d="M9 20.5 A1.5 1.5 0 1 1 8.99 20.5 Z"/></svg>
        <span class="mode-name">GOO</span>
        <span class="mode-sub">Sticky strands</span>
      </button>
    </div>
    <span id="armory-mode-desc" class="desc">Paint gauntlet. Hold the pinch to auto-fire.</span>
    <span class="label">SKIN</span>
    <div class="skin-row">
      <button id="btn-skin-prev" class="btn-arrow">&lt;</button>
      <div id="armory-skin-card" class="skin-card">
        <div id="armory-skin-swatch" class="skin-swatch"></div>
        <div class="skin-text">
          <span id="armory-skin-name" class="skin-name">NEON CORAL</span>
          <span id="armory-skin-index" class="label">SKIN 1 OF 5</span>
        </div>
      </div>
      <button id="btn-skin-next" class="btn-arrow">&gt;</button>
    </div>
    <div class="dot-row">
      <button id="btn-skin-0" class="skin-dot"></button>
      <button id="btn-skin-1" class="skin-dot"></button>
      <button id="btn-skin-2" class="skin-dot"></button>
      <button id="btn-skin-3" class="skin-dot"></button>
      <button id="btn-skin-4" class="skin-dot"></button>
    </div>
    <div class="btn-row">
      <button id="btn-armory-back" class="btn-line line-glass">&lt; BACK</button>
      <button id="btn-armory-play" class="btn-play-small"><svg class="icon-s" viewBox="0 0 24 24"><path fill="#0b0c14" d="M6 3.5 L21 12 L6 20.5 Z"/></svg><span class="btn-text-s">PLAY</span><div class="spacer-s"></div></button>
    </div>
  </div>

  <!-- ===== Tutorial card (Pip leads; replaces the phase section) ======== -->
  <div id="section-tutorial" class="section-hidden">
    <div class="tut-head">
      <span class="kicker-lime">PIP'S TRAINING</span>
      <span id="tut-step" class="tut-count">STEP 1 OF 5</span>
    </div>
    <span id="tut-line" class="tut-line">Pinch to fire at the ring!</span>
    <div class="dot-row">
      <div id="tut-dot-0" class="tut-dot"></div>
      <div id="tut-dot-1" class="tut-dot"></div>
      <div id="tut-dot-2" class="tut-dot"></div>
      <div id="tut-dot-3" class="tut-dot"></div>
      <div id="tut-dot-4" class="tut-dot"></div>
    </div>
    <div class="tut-foot">
      <span class="hint">Or hold both pinches to skip</span>
      <button id="btn-tut-skip" class="btn-line line-glass btn-skip">SKIP</button>
    </div>
  </div>

  <!-- ===== Footer (always up) ========================================== -->
  <div class="footer">
    <button id="btn-clear" class="btn-glass">CLEAR PAINT</button>
    <div class="footer-right">
      <span id="hud-mode" class="mode-chip">BLASTER</span>
      <div class="ammo-chip">
        <div id="hud-ammo-swatch" class="swatch"></div>
        <span id="hud-ammo" class="ammo">NORMAL</span>
      </div>
    </div>
  </div>
</div>
</div>
